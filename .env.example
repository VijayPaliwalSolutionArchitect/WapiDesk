# WapiDesk — .env example
# Copy to .env and fill in real values for production. Never commit real secrets.

# --- Core ---
APP_NAME=WapiDesk API
APP_VERSION=1.0.0
DEBUG=false

# --- Persistence ---
# SQLite file path. Use :memory: for tests.
DATABASE_URL=./data/wapidesk.db

# --- WhatsApp Cloud API (Meta) — required for live WhatsApp ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional external brain / desk proxies (leave empty for the offline demo brain) ---
DIFY_AGENT_URL=
DIFY_AGENT_KEY=
RAGFLOW_URL=
RAGFLOW_API_KEY=
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_TOKEN=

# --- Behavior ---
KNOWLEDGE_MAX_SOURCES=3
QA_CONFIDENCE_THRESHOLD=0.4
DEFAULT_HOURS=09:00-18:00
