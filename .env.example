# WapiDesk — environment template (copy to backend/.env)
# NEVER commit real values. All credentials are placeholders.
# Loaded by pydantic-settings (backend/app/config.py); env vars override this file.

# --- Core ---
APP_NAME=WapiDesk API
APP_VERSION=1.0.0
DEBUG=false

# --- Persistence ---
# SQLite file path; use :memory: for ephemeral (tests use this)
DATABASE_URL=./data/wapidesk.db

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_WEBHOOK_SECRET=your-app-secret-here
WHATSAPP_CLOUD_API_TOKEN=your-cloud-api-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# --- Optional external brain / desk (leave empty for the offline demo brain) ---
DIFY_AGENT_URL=
DIFY_AGENT_KEY=
RAGFLOW_URL=
RAGFLOW_API_KEY=
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_TOKEN=

# --- Behavior ---
KNOWLEDGE_MAX_SOURCES=3
QA_CONFIDENCE_THRESHOLD=0.4
DEFAULT_HOURS=09:00-18:00
